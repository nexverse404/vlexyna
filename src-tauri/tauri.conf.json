{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vlexyna",
  "version": "2.4.0",
  "identifier": "com.vlexyna.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vlexyna Studio",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "backgroundColor": "#0a0b0e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Multimedia",
    "shortDescription": "Audio-reactive music video studio",
    "longDescription": "Vlexyna Studio \u2014 a free, unlimited, audio-reactive music video studio. Spectrum, particles, GLSL shaders, lyrics, 60+ effects and 4K export, all local in your machine.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
